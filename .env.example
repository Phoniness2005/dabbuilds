# Copy to .env.local and fill in. Never commit real values.
SFTP_HOST=sftp.elementor.cloud
SFTP_PORT=32022
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_ROOT=/html

# Optional — WordPress Application Password for REST API (not required for SFTP deploy)
WP_URL=https://dabbuilds.com
WP_USER=
WP_APP_PASSWORD=
